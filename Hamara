var otpTimerRef = null;
function startOtpTimer(){
  var t = 60;
  $('otp-timer').textContent = 'Resend: '+t+'s';
  if(otpTimerRef)clearInterval(otpTimerRef);
  otpTimerRef = setInterval(function(){
    t--;
    if(t<=0){clearInterval(otpTimerRef);$('otp-timer').textContent='Resend karein';}
    else $('otp-timer').textContent='Resend: '+t+'s';
  },1000);
}
function sendOTP(){
  var phone = $('phone-inp').value.trim();
  if(phone.length < 7){showToast('Sahi number darj karein');return;}
  var cc = $('cc-sel').value || '+92';
  var fullPhone = cc + phone.replace(/^0+/, '');
  $('phone-status').textContent = 'OTP bheja ja raha hai...';
  /* Setup reCAPTCHA if not already done */
  if(!window._recapVerifier){
    try{
      window._recapVerifier = new RecaptchaVerifier(auth, 'recaptcha-container', {
        size: 'normal',
        callback: function(){},
        'expired-callback': function(){ window._recapVerifier = null; }
      });
    }catch(e){
      $('phone-status').textContent = 'reCAPTCHA error: '+e.message;
      return;
    }
  }
  signInWithPhoneNumber(auth, fullPhone, window._recapVerifier)
    .then(function(confirmationResult){
      window._fbConfirmation = confirmationResult;
      $('phone-status').textContent = '';
      $('otp-sub').textContent = 'Code bheja: ' + fullPhone;
      goScreen('otp');
      startOtpTimer();
      showToast('OTP bhej diya! ✅');
    })
    .catch(function(err){
      $('phone-status').textContent = err.message || 'OTP send nahi hua';
      showToast('Error: ' + (err.message || 'OTP send failed'));
      /* Reset verifier on error so user can retry */
      if(window._recapVerifier){ try{ window._recapVerifier.clear(); }catch(e2){} window._recapVerifier = null; }
    });
}
function otpNext(el,nextId){if(el.value&&nextId)$(nextId).focus();}
function verifyOTP(){
  var code = ['o1','o2','o3','o4','o5','o6'].map(function(id){return $(id)?$(id).value:'';}).join('');
  if(window._fbConfirmation){
    window._fbConfirmation.confirm(code)
      .then(function(result){
        var fbUser = result.user;
        /* Keep existing profile data if already set, just update phone */
        var saved = localStorage.getItem('hm_user_v7');
        if(saved){ APP.user = JSON.parse(saved); APP.user.phone = fbUser.phoneNumber; goMainApp(); }
        else{
          APP.user = { phone: fbUser.phoneNumber };
          goScreen('profile-setup');
        }
        localStorage.setItem('hm_user_v7', JSON.stringify(APP.user));
        showToast('Phone verify ho gaya! ✅');
      })
      .catch(function(){
        showToast('Galat OTP. Dobara koshish karein.');
      });
    return;
  }
  /* Fallback demo mode */
  if(code!=='123456'){showToast('Galat OTP. Demo: 123456');return;}
  var saved = localStorage.getItem('hm_user_v7');
  if(saved){APP.user=JSON.parse(saved);goMainApp();}
  else goScreen('profile-setup');
}
