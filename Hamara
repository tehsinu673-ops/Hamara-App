.story-viewer.open{display:flex;}
.story-prog-bar{display:flex;gap:3px;padding:10px 12px 6px;}
.story-seg{flex:1;height:3px;background:#ffffff44;border-radius:3px;overflow:hidden;}
.story-seg-fill{height:100%;background:#fff;border-radius:3px;transition:width linear;}
.story-content-area{flex:1;display:flex;align-items:center;justify-content:center;font-size:80px;cursor:pointer;position:relative;}
.story-text-overlay{position:absolute;bottom:100px;left:20px;right:20px;text-align:center;color:#fff;font-size:18px;font-weight:700;text-shadow:0 2px 8px #000;}
.story-reply-bar{display:flex;gap:8px;padding:8px 12px 24px;flex-shrink:0;}

