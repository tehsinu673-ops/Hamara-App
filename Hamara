function renderMsg(m){
  if(m.deleted)return '<div style="display:flex;justify-content:'+(m.t==='out'?'flex-end':'flex-start')+'"><div class="bubble '+m.t+' del"><i class="fas fa-ban" style="font-size:11px;color:var(--d2);margin-right:5px;"></i><span class="bubble-txt" style="color:var(--d2);">Message delete ho gaya</span></div></div>';
  var inner='';
  if(m.replyTo)inner+='<div class="reply-preview" onclick="event.stopPropagation()"><div class="reply-preview-name">'+m.replyTo.name+'</div><div class="reply-preview-txt">'+m.replyTo.tx+'</div></div>';
  if(m.type==='text'||!m.type)inner+='<div class="bubble-txt">'+escHtml(m.tx||'')+(m.edited?' <span style="color:var(--d2);font-size:10px;">(edited)</span>':'')+'</div>';
  else if(m.type==='voice')inner+='<div class="voice-bubble"><button class="play-btn" onclick="playVoice(this)"><i class="fas fa-play"></i></button><div class="waveform">'+Array.from({length:20},function(_,i){return '<div class="wbar" style="height:'+(10+Math.random()*18)+'px;"></div>';}).join('')+'</div><span style="color:var(--d2);font-size:11px;min-width:30px;text-align:right;">'+m.voiceDur+'</span></div>';
  else if(m.type==='image')inner+='<div class="media-bubble"><img src="'+m.mediaUrl+'" alt="" loading="lazy" style="max-width:220px;width:100%;border-radius:10px;" onclick="showToast(\'Image view 🖼️\')"></div>';
  else if(m.type==='doc')inner+='<div class="doc-bubble"><div class="doc-icon"><i class="fas fa-file-pdf"></i></div><div><div style="color:var(--t1);font-size:13px;font-weight:700;">'+m.docName+'</div><div style="color:var(--d2);font-size:11px;">'+m.docSize+'</div></div></div>';
  else if(m.type==='location')inner+='<div style="background:var(--bg4);border-radius:10px;padding:10px 12px;"><i class="fas fa-map-marker-alt" style="color:var(--red);"></i> <span style="color:var(--t1);font-size:13px;">Location share kiya 📍</span></div>';
  else if(m.type==='poll')inner+=m.tx||'';
  else inner+='<div class="bubble-txt">'+escHtml(m.tx||'')+'</div>';
  var ticks='';
  if(m.t==='out')ticks='<i class="fas fa-check-double tick'+(m.read?' read':'')+'"></i>';
  inner+='<div class="bubble-meta"><span class="bubble-time">'+m.ti+'</span>'+ticks+'</div>';
  if(m.reactions&&m.reactions.length)inner+='<div class="reactions-row">'+m.reactions.map(function(r){return '<span class="reaction-chip">'+r.emoji+'</span>';}).join('')+'</div>';
  return '<div style="display:flex;justify-content:'+(m.t==='out'?'flex-end':'flex-start')+'"><div class="bubble '+m.t+'" id="msg-'+m.id+'" oncontextmenu="openMsgMenu(event,\''+m.id+'\')" ontouchstart="startLongPress(event,\''+m.id+'\')" ontouchend="cancelLongPress()">'+inner+'</div></div>';
}
function escHtml(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

/* ── SEND MESSAGES ── */
var msgInput=null;
function msgKeyDown(e){
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendTextMsg();}
  else{var sb=$('send-btn'),rb=$('record-btn');if(sb&&rb){sb.style.display=e.target.value.trim()||e.target.value?'flex':'none';rb.style.display=e.target.value.trim()||e.target.value?'none':'flex';}}
}
function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,120)+'px';var sb=$('send-btn'),rb=$('record-btn');if(sb&&rb){sb.style.display=el.value.trim()?'flex':'none';rb.style.display=el.value.trim()?'none':'flex';}}
function sendTextMsg(){
  var inp=$('msg-input');var tx=inp.value.trim();
  if(!tx&&!APP.editMsgId)return;
  if(!APP.msgs[APP.openChatId])APP.msgs[APP.openChatId]=[];
  if(APP.editMsgId){
    var em=APP.msgs[APP.openChatId].find(function(m){return m.id===APP.editMsgId;});
    if(em){em.tx=tx;em.edited=true;}
    cancelEdit();
  } else {
    var msg={id:'m'+Date.now(),t:'out',tx:tx,ti:getTime(),type:'text',read:false};
    if(APP.replyMsgId){
      var rm=APP.msgs[APP.openChatId].find(function(m){return m.id===APP.replyMsgId;});
      if(rm)msg.replyTo={id:rm.id,name:'Aap',tx:rm.tx||'[Media]'};
      clearReply();
    }
    APP.msgs[APP.openChatId].push(msg);
    var chat=APP.chats.find(function(c){return c.id===APP.openChatId;});
    if(chat){chat.pre=tx;chat.t=getTime();}
    // Auto-reply simulation
    if(chat&&chat.online){
      setTimeout(function(){
        $('typing-bar').style.display='flex';
        setTimeout(function(){
          $('typing-bar').style.display='none';
          var replies=['Haan bhai bilkul! 😊','InshAllah zaroor!','Thik hai, dekhtey hain 👍','MashAllah! 🌟','Haha yar 😂 sach mein?','Ok understood 👌'];
          var r={id:'r'+Date.now(),t:'in',tx:replies[Math.floor(Math.random()*replies.length)],ti:getTime(),type:'text',read:false};
          APP.msgs[APP.openChatId].push(r);
          if(chat)chat.pre=r.tx;
          renderMessages();renderChatList();saveState();
        },1800);
      },800);
    }
  }
  inp.value='';inp.style.height='auto';
  $('send-btn').style.display='none';$('record-btn').style.display='flex';
  renderMessages();renderChatList();saveState();
}
function showTyping(){
  var inp=$('msg-input');var sb=$('send-btn'),rb=$('record-btn');
  if(sb&&rb){sb.style.display=inp.value.trim()?'flex':'none';rb.style.display=inp.value.trim()?'none':'flex';}
}
var voiceDuration=0,voiceTimer=null,isRecording=false;
function startRecording(){
  isRecording=true;voiceDuration=0;
  $('record-btn').className='record-btn recording';
  voiceTimer=setInterval(function(){voiceDuration++;},1000);
  showToast('Recording... 🎤');
}
function stopRecording(){
  if(!isRecording)return;isRecording=false;clearInterval(voiceTimer);
  $('record-btn').className='record-btn idle';
  var dur=Math.floor(voiceDuration/60).toString().padStart(2,'0')+':'+String(voiceDuration%60).padStart(2,'0');
  if(voiceDuration<1){showToast('Too short!');return;}
  if(!APP.msgs[APP.openChatId])APP.msgs[APP.openChatId]=[];
  APP.msgs[APP.openChatId].push({id:'v'+Date.now(),t:'out',tx:'',ti:getTime(),type:'voice',voiceDur:dur,read:false});
  var chat=APP.chats.find(function(c){return c.id===APP.openChatId;});
  if(chat){chat.pre='🎤 Voice message';chat.t=getTime();}
  renderMessages();renderChatList();saveState();
  showToast('Voice note bhej diya 🎤');
}
function playVoice(btn){btn.innerHTML='<i class="fas fa-pause"></i>';setTimeout(function(){btn.innerHTML='<i class="fas fa-play"></i>';},2000);}
function sendMediaMsg(inp){
  var file=inp.files[0];if(!file)return;
  var url=URL.createObjectURL(file);
  APP.msgs[APP.openChatId].push({id:'img'+Date.now(),t:'out',tx:'',ti:getTime(),type:'image',mediaUrl:url,read:false});
  var chat=APP.chats.find(function(c){return c.id===APP.openChatId;});
  if(chat){chat.pre='📷 Photo';chat.t=getTime();}
  renderMessages();renderChatList();saveState();inp.value='';
}
function sendDocMsg(inp){
  var file=inp.files[0];if(!file)return;
  var size=file.size>1024*1024?(file.size/1024/1024).toFixed(1)+' MB':(file.size/1024).toFixed(0)+' KB';
  APP.msgs[APP.openChatId].push({id:'doc'+Date.now(),t:'out',tx:'',ti:getTime(),type:'doc',docName:file.name,docSize:size,read:false});
  var chat=APP.chats.find(function(c){return c.id===APP.openChatId;});
  if(chat){chat.pre='📄 '+file.name;chat.t=getTime();}
  renderMessages();renderChatList();saveState();inp.value='';
}
function sendLocationMsg(){
  if(!APP.msgs[APP.openChatId])APP.msgs[APP.openChatId]=[];
  APP.msgs[APP.openChatId].push({id:'loc'+Date.now(),t:'out',tx:'',ti:getTime(),type:'location',read:false});
  var chat=APP.chats.find(function(c){return c.id===APP.openChatId;});
  if(chat){chat.pre='📍 Location';chat.t=getTime();}
  closeAttach();renderMessages();renderChatList();saveState();
  showToast('Location share ho gaya 📍');
}

