<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1"/>
<meta name="theme-color" content="#064e3b"/>
<meta name="mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="apple-mobile-web-app-title" content="Hamara"/>
<title>Hamara v7.0 Gold PRO</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
/* ═══════════════════════════════════════════════
   HAMARA v7.0 GOLD PRO — COMPLETE DESIGN SYSTEM
   ═══════════════════════════════════════════════ */
:root{
  --bg:#080d0b;--bg2:#0e1612;--bg3:#141f1a;--bg4:#1a2820;--bg5:#1f3028;
  --g9:#064e3b;--g8:#065f46;--g7:#047857;--g6:#059669;--g5:#10b981;--g4:#34d399;--g3:#6ee7b7;
  --bc:#1c3028;--bc2:#243d32;
  --t1:#f0fdf8;--t2:#bbf7d0;--t3:#86efac;--t4:#4ade80;
  --d1:#94a3b8;--d2:#64748b;--d3:#334155;
  --red:#f43f5e;--gold:#f59e0b;--blue:#38bdf8;--purple:#a78bfa;--pink:#f472b6;--orange:#fb923c;
  --r:14px;--r2:10px;--r3:20px;
  --glass:rgba(14,22,18,.85);
}
body.light{
  --bg:#f0fdf4;--bg2:#dcfce7;--bg3:#f7fef9;--bg4:#e6f9ee;--bg5:#d1fae5;
  --bc:#86efac;--bc2:#4ade80;
  --t1:#052e16;--t2:#14532d;--t3:#166534;--t4:#15803d;
  --d1:#374151;--d2:#6b7280;--d3:#9ca3af;
  --glass:rgba(240,253,244,.92);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html{height:100%;background:#000;}
body{height:100%;font-family:'Outfit',sans-serif;display:flex;justify-content:center;background:#000;overflow:hidden;}
#app{
  width:100%;max-width:480px;height:100dvh;background:var(--bg);
  position:relative;overflow:hidden;display:flex;flex-direction:column;
  box-shadow:0 0 100px #064e3b44;
}
.screen{display:none;flex-direction:column;flex:1;overflow:hidden;}
.screen.active{display:flex;}
::-webkit-scrollbar{width:3px;height:3px;}
::-webkit-scrollbar-thumb{background:var(--bc2);border-radius:3px;}

/* ── TOPBAR ── */
.topbar{display:flex;align-items:center;gap:10px;padding:12px 14px 8px;background:var(--glass);backdrop-filter:blur(20px);border-bottom:1px solid var(--bc);flex-shrink:0;}
.topbar-title{font-size:17px;font-weight:800;color:var(--t1);flex:1;}
.iBtn{width:36px;height:36px;border-radius:10px;background:transparent;border:none;color:var(--d1);font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;font-family:'Outfit',sans-serif;}
.iBtn:active{background:var(--bg4);color:var(--t1);}

/* ── BOTTOM NAV ── */
.bnav{display:flex;background:var(--glass);backdrop-filter:blur(20px);border-top:1px solid var(--bc);padding:4px 0 max(4px,env(safe-area-inset-bottom));flex-shrink:0;}
.bnav-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;padding:6px 0;position:relative;background:none;border:none;transition:all .18s;}
.bnav-btn i{font-size:20px;color:var(--d3);transition:all .2s;}
.bnav-btn span{font-size:9px;color:var(--d3);font-weight:700;letter-spacing:.3px;transition:all .2s;}
.bnav-btn.active i,.bnav-btn.active span{color:var(--g4);}
.bnav-btn.active::before{content:'';position:absolute;top:-1px;left:20%;right:20%;height:2.5px;background:var(--g4);border-radius:0 0 4px 4px;}
.bnav-badge{position:absolute;top:2px;right:calc(50% - 20px);background:var(--red);color:#fff;font-size:9px;font-weight:800;padding:2px 5px;border-radius:10px;min-width:16px;text-align:center;border:2px solid var(--bg);}

/* ── AVATAR ── */
.av{border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;color:#fff;flex-shrink:0;position:relative;font-family:'Outfit',sans-serif;}
.av1{background:linear-gradient(135deg,#7c3aed,#4c1d95);}
.av2{background:linear-gradient(135deg,#db2777,#831843);}
.av3{background:linear-gradient(135deg,#d97706,#92400e);}
.av4{background:linear-gradient(135deg,#0369a1,#0c4a6e);}
.av5{background:linear-gradient(135deg,#065f46,#022c22);}
.av6{background:linear-gradient(135deg,#b45309,#78350f);}
.av7{background:linear-gradient(135deg,#0f766e,#134e4a);}
.av8{background:linear-gradient(135deg,#be185d,#500724);}
.av-me{background:linear-gradient(135deg,var(--g6),var(--g9));}
.online-dot{position:absolute;bottom:0;right:0;width:12px;height:12px;border-radius:50%;background:#22c55e;border:2.5px solid var(--bg);}

/* ── AUTH ── */
.auth-hero{min-height:50vh;background:linear-gradient(170deg,var(--g9),var(--bg));padding:48px 24px 64px;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;}
.auth-hero::after{content:'';position:absolute;bottom:-40px;left:-20px;right:-20px;height:60px;background:var(--bg);border-radius:50%;}
.auth-body{padding:24px 20px 40px;overflow-y:auto;flex:1;}
.logo-pulse{width:80px;height:80px;border-radius:24px;background:linear-gradient(135deg,var(--g5),var(--g9));display:flex;align-items:center;justify-content:center;font-size:36px;animation:pulse 2s ease-in-out infinite;box-shadow:0 0 60px #10b98155;position:relative;z-index:1;}
@keyframes pulse{0%,100%{box-shadow:0 0 40px #10b98144;}50%{box-shadow:0 0 80px #10b981aa;}}
.finput-wrap{background:var(--bg3);border:1.5px solid var(--bc);border-radius:var(--r2);margin-bottom:14px;overflow:hidden;transition:border-color .2s;}
.finput-wrap:focus-within{border-color:var(--g6);}
.finput{width:100%;background:transparent;border:none;color:var(--t1);font-size:15px;padding:13px 14px;font-family:'Outfit',sans-serif;outline:none;}
.finput::placeholder{color:var(--d3);}
.btn-primary{width:100%;padding:14px;background:linear-gradient(135deg,var(--g6),var(--g8));border:none;border-radius:var(--r2);color:#fff;font-size:15px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 6px 24px #05996966;transition:opacity .15s,transform .12s;}
.btn-primary:active{opacity:.88;transform:scale(.98);}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--g5),var(--g4));border-radius:3px;animation:fill 1.5s ease forwards;}
@keyframes fill{from{width:0}to{width:100%}}

/* ── PILLS / TAGS ── */
.pill{background:#10b98120;border:1px solid #10b98140;border-radius:20px;padding:5px 12px;color:var(--g3);font-size:12px;font-weight:700;}
.sec-hdr{padding:12px 14px 6px;color:var(--d2);font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;}

/* ── STORIES ── */
.stories-bar{display:flex;gap:10px;padding:10px 12px;overflow-x:auto;border-bottom:1px solid var(--bc);flex-shrink:0;background:var(--bg2);}
.stories-bar::-webkit-scrollbar{height:0;}
.story-chip{display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;flex-shrink:0;}
.story-ring{width:52px;height:52px;border-radius:50%;padding:2px;background:linear-gradient(135deg,var(--g5),var(--g4));display:flex;align-items:center;justify-content:center;}
.story-ring.seen{background:var(--bc2);}
.story-av{width:46px;height:46px;border-radius:50%;background:var(--bg3);border:2px solid var(--bg2);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;}
.story-name{color:var(--d1);font-size:10px;font-weight:600;max-width:52px;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.add-story{width:52px;height:52px;border-radius:50%;background:var(--bg4);border:2px dashed var(--bc2);display:flex;align-items:center;justify-content:center;cursor:pointer;}

/* ── CHAT LIST ── */
.search-bar{padding:9px 12px;background:var(--bg2);border-bottom:1px solid var(--bc);flex-shrink:0;}
.search-inner{display:flex;align-items:center;gap:8px;background:var(--bg3);border:1px solid var(--bc);border-radius:12px;padding:9px 12px;transition:border-color .2s;}
.search-inner:focus-within{border-color:var(--g6);}
.search-inner i{color:var(--d2);font-size:13px;}
.search-inner input{background:transparent;border:none;outline:none;color:var(--t1);font-size:14px;flex:1;font-family:'Outfit',sans-serif;}
.search-inner input::placeholder{color:var(--d3);}
.filter-bar{display:flex;background:var(--bg2);border-bottom:1px solid var(--bc);flex-shrink:0;}
.fb{flex:1;padding:10px 4px;font-size:12px;font-weight:700;color:var(--d2);cursor:pointer;border-bottom:2.5px solid transparent;transition:all .2s;background:none;border-top:none;border-left:none;border-right:none;font-family:'Outfit',sans-serif;text-align:center;}
.fb.active{color:var(--g4);border-bottom-color:var(--g4);}
.chat-row{display:flex;align-items:center;gap:11px;padding:9px 14px;cursor:pointer;transition:background .12s;position:relative;}
.chat-row:active{background:var(--bg3);}
.chat-row::after{content:'';position:absolute;bottom:0;left:72px;right:0;height:1px;background:var(--bc);}
.chat-row-name{color:var(--t1);font-size:14.5px;font-weight:700;}
.chat-row-sub{color:var(--d2);font-size:12.5px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px;}
.chat-time{color:var(--d2);font-size:11px;}
.unread{background:var(--g6);color:#fff;font-size:10px;font-weight:800;padding:2px 6px;border-radius:10px;min-width:18px;text-align:center;}
.pinned-bar{display:flex;align-items:center;gap:12px;padding:8px 14px;background:var(--bg2);border-bottom:1px solid var(--bc);flex-shrink:0;overflow-x:auto;}
.pinned-bar::-webkit-scrollbar{height:0;}
.pin-chip{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;flex-shrink:0;}
.pin-chip-av{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;border:2.5px solid var(--g5);}
.pin-chip-name{color:var(--d1);font-size:9px;font-weight:700;max-width:44px;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

/* ── CHAT WINDOW ── */
.msgs-wrap{flex:1;overflow-y:auto;padding:10px 12px;display:flex;flex-direction:column;gap:3px;}
.date-sep{text-align:center;color:var(--d2);font-size:11px;margin:8px 0;}
.date-sep span{background:var(--bg3);padding:3px 10px;border-radius:20px;border:1px solid var(--bc);}
.e2e-badge{background:#05996918;border:1px solid #05996940;color:var(--g3);font-size:11.5px;padding:7px 12px;margin:6px 12px;border-radius:10px;text-align:center;flex-shrink:0;}
.bubble{max-width:78%;padding:9px 12px 5px;border-radius:16px;position:relative;word-break:break-word;}
.bubble.in{background:var(--bg3);border:1px solid var(--bc);border-bottom-left-radius:4px;align-self:flex-start;}
.bubble.out{background:linear-gradient(135deg,var(--g9),#0a4832);border:1px solid var(--g8);border-bottom-right-radius:4px;align-self:flex-end;}
.bubble.del{opacity:.55;font-style:italic;}
.bubble-txt{color:var(--t1);font-size:14.5px;line-height:1.5;}
.bubble-meta{display:flex;align-items:center;gap:4px;justify-content:flex-end;margin-top:4px;}
.bubble-time{color:var(--d2);font-size:10.5px;}
.tick{color:var(--d2);font-size:10px;}
.tick.read{color:var(--blue);}
.reply-preview{background:var(--bg4);border-left:3px solid var(--g5);border-radius:6px;padding:5px 9px;margin-bottom:6px;cursor:pointer;}
.reply-preview-name{color:var(--g4);font-size:11px;font-weight:700;}
.reply-preview-txt{color:var(--d1);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:200px;}
.reactions-row{display:flex;gap:3px;flex-wrap:wrap;margin-top:4px;}
.reaction-chip{background:var(--bg4);border:1px solid var(--bc);border-radius:20px;padding:2px 7px;font-size:12px;cursor:pointer;}
.voice-bubble{display:flex;align-items:center;gap:10px;padding:2px 4px;}
.waveform{display:flex;align-items:center;gap:2px;height:28px;}
.wbar{background:var(--g4);border-radius:2px;width:3px;transition:height .1s;}
.wbar.played{background:var(--g6);}
.play-btn{width:34px;height:34px;border-radius:50%;background:var(--g6);border:none;color:#fff;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.media-bubble{border-radius:12px;overflow:hidden;cursor:pointer;max-width:220px;position:relative;}
.media-bubble img{width:100%;display:block;}
.doc-bubble{display:flex;align-items:center;gap:10px;background:var(--bg4);border-radius:10px;padding:10px 12px;min-width:180px;}
.doc-icon{width:38px;height:38px;border-radius:10px;background:#0369a120;display:flex;align-items:center;justify-content:center;font-size:18px;color:#38bdf8;flex-shrink:0;}
.typing-indicator{display:flex;align-items:center;gap:4px;padding:10px 14px 4px;flex-shrink:0;}
.typing-dot{width:7px;height:7px;border-radius:50%;background:var(--g4);animation:tdot .9s infinite;}
.typing-dot:nth-child(2){animation-delay:.2s;}
.typing-dot:nth-child(3){animation-delay:.4s;}
@keyframes tdot{0%,60%,100%{transform:translateY(0);}30%{transform:translateY(-5px);}}
.cw-input{display:flex;align-items:flex-end;gap:8px;padding:8px 10px;background:var(--glass);backdrop-filter:blur(20px);border-top:1px solid var(--bc);flex-shrink:0;}
.cw-input-box{flex:1;display:flex;align-items:flex-end;background:var(--bg3);border:1.5px solid var(--bc);border-radius:22px;padding:4px 6px 4px 10px;transition:border-color .2s;}
.cw-input-box:focus-within{border-color:var(--g6);}
.cw-ta{flex:1;background:transparent;border:none;color:var(--t1);font-size:14.5px;padding:8px 6px;font-family:'Outfit',sans-serif;outline:none;resize:none;max-height:120px;line-height:1.4;}
.cw-ta::placeholder{color:var(--d3);}
.send-btn{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--g6),var(--g8));border:none;color:#fff;font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px #05996955;transition:transform .12s;}
.send-btn:active{transform:scale(.92);}
.record-btn{width:42px;height:42px;border-radius:50%;border:none;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s;}
.record-btn.idle{background:var(--bg4);color:var(--d1);}
.record-btn.recording{background:var(--red);color:#fff;animation:pulse 1s infinite;}
.attach-sheet{position:fixed;bottom:0;left:50%;transform:translate(-50%,110%);width:100%;max-width:480px;background:var(--bg2);border-radius:22px 22px 0 0;border-top:1px solid var(--bc);z-index:280;padding:16px 20px 30px;transition:transform .32s cubic-bezier(.25,.46,.45,.94);}
.attach-sheet.open{transform:translate(-50%,0);}
.attach-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:12px;}
.attach-opt{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;}
.attach-icon{width:52px;height:52px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:21px;}
.attach-lbl{color:var(--d1);font-size:11px;font-weight:600;}
.reply-bar{display:flex;align-items:center;gap:10px;padding:8px 14px;background:var(--bg2);border-top:1px solid var(--bc);flex-shrink:0;}
.edit-bar{display:flex;align-items:center;gap:10px;padding:8px 14px;background:#38bdf810;border-top:1px solid #38bdf840;flex-shrink:0;}
.msg-search-row{display:flex;align-items:center;gap:8px;padding:7px 10px;background:var(--bg2);border-bottom:1px solid var(--bc);flex-shrink:0;}
.msg-search-row input{flex:1;background:var(--bg3);border:1px solid var(--bc);border-radius:10px;color:var(--t1);font-size:14px;padding:7px 12px;outline:none;font-family:'Outfit',sans-serif;}

/* ── SETTINGS ── */
.s-sec-hdr{padding:14px 14px 6px;color:var(--d2);font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;background:var(--bg2);}
.s-row{display:flex;align-items:center;gap:13px;padding:13px 14px;border-bottom:1px solid var(--bc);cursor:pointer;transition:background .12s;}
.s-row:active{background:var(--bg3);}
.s-icon{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
.s-title{color:var(--t1);font-size:14.5px;font-weight:700;}
.s-sub{color:var(--d2);font-size:12px;margin-top:2px;}
.toggle{width:44px;height:24px;border-radius:12px;background:var(--bc2);position:relative;cursor:pointer;transition:background .2s;flex-shrink:0;}
.toggle::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:transform .2s;}
.toggle.on{background:var(--g6);}
.toggle.on::after{transform:translateX(20px);}

/* ── PROFILE ── */
.profile-cover{height:130px;background:linear-gradient(135deg,var(--g9),#052e1c);position:relative;}
.profile-av-wrap{border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;margin-top:-48px;border:4px solid var(--bg2);box-shadow:0 6px 24px #00000066;font-family:'Outfit',sans-serif;}
.p-stats{display:flex;border-top:1px solid var(--bc);border-bottom:1px solid var(--bc);background:var(--bg2);}
.p-stat{flex:1;padding:14px 6px;text-align:center;border-right:1px solid var(--bc);}
.p-stat:last-child{border-right:none;}
.p-stat-n{color:var(--t1);font-size:18px;font-weight:900;}
.p-stat-l{color:var(--d2);font-size:11px;font-weight:600;margin-top:2px;}
.vid-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;padding:2px;}
.vg-item{aspect-ratio:9/16;background:var(--bg3);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer;position:relative;overflow:hidden;transition:opacity .15s;}
.vg-item:active{opacity:.7;}
.vg-views{position:absolute;bottom:4px;left:4px;color:#fff;font-size:10px;font-weight:700;text-shadow:0 1px 3px #000;}

/* ── GROUPS ── */
.group-row{display:flex;align-items:center;gap:12px;padding:11px 14px;border-bottom:1px solid var(--bc);cursor:pointer;transition:background .12s;}
.group-row:active{background:var(--bg3);}
.poll-card{background:var(--bg3);border:1.5px solid var(--bc);border-radius:14px;padding:14px;margin:10px 14px;}
.poll-opt{background:var(--bg4);border:1.5px solid var(--bc);border-radius:10px;padding:10px 14px;margin-bottom:8px;position:relative;overflow:hidden;cursor:pointer;transition:border-color .2s;}
.poll-opt.voted{border-color:var(--g5);}
.poll-fill{position:absolute;left:0;top:0;bottom:0;background:#10b98118;transition:width .6s cubic-bezier(.25,.46,.45,.94);border-radius:10px;}
.poll-row{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;}
.poll-lbl{color:var(--t1);font-size:14px;font-weight:600;}
.poll-pct{color:var(--g4);font-size:12px;font-weight:800;}

/* ── STUDIO (TikTok) ── */
.vid-feed{flex:1;overflow-y:scroll;scroll-snap-type:y mandatory;-webkit-overflow-scrolling:touch;position:relative;}
.vid-feed::-webkit-scrollbar{display:none;}
.vid-card{height:100dvh;flex-shrink:0;position:relative;scroll-snap-align:start;display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:pointer;}
.vid-bg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:110px;user-select:none;}
.vid-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.3) 0%,transparent 30%,transparent 50%,rgba(0,0,0,.8) 100%);}
.vid-right{position:absolute;right:12px;bottom:100px;display:flex;flex-direction:column;align-items:center;gap:18px;}
.vid-act{display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer;}
.vid-act i{font-size:26px;color:#fff;filter:drop-shadow(0 2px 4px #000a);}
.vid-act span{color:#fff;font-size:12px;font-weight:700;text-shadow:0 1px 3px #000;}
.vid-bottom{position:absolute;bottom:0;left:0;right:60px;padding:16px 14px 90px;}
.vid-user{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
