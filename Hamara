}
function closeAllMenus(){$('msg-menu').classList.remove('open');closeAttach();$('overlay').classList.remove('open');}
function addReaction(em){
  closeAllMenus();
  if(!APP.selectedMsgId)return;
  var msgs=APP.msgs[APP.openChatId]||[];
  var msg=msgs.find(function(m){return m.id===APP.selectedMsgId;});
  if(!msg)return;
  if(!msg.reactions)msg.reactions=[];
  var ex=msg.reactions.find(function(r){return r.emoji===em&&r.me;});
  if(ex)msg.reactions=msg.reactions.filter(function(r){return !(r.emoji===em&&r.me);});
  else msg.reactions.push({emoji:em,me:true});
  renderMessages();saveState();
}
function replyToMsg(){
  closeAllMenus();
  var msgs=APP.msgs[APP.openChatId]||[];
  var msg=msgs.find(function(m){return m.id===APP.selectedMsgId;});
  if(!msg)return;
  APP.replyMsgId=msg.id;
  var rb=$('reply-bar');rb.style.display='flex';
  $('reply-name').textContent=msg.t==='out'?'Aap':'Contact';
  $('reply-text').textContent=msg.tx||'[Media]';
  $('msg-input').focus();
}
function clearReply(){APP.replyMsgId=null;var rb=$('reply-bar');if(rb)rb.style.display='none';}
function editMsg(){
  closeAllMenus();
  var msgs=APP.msgs[APP.openChatId]||[];
  var msg=msgs.find(function(m){return m.id===APP.selectedMsgId;});
  if(!msg||msg.t!=='out')return;
  APP.editMsgId=msg.id;
  var inp=$('msg-input');inp.value=msg.tx;inp.focus();
  var eb=$('edit-bar');if(eb)eb.style.display='flex';
  $('send-btn').style.display='flex';$('record-btn').style.display='none';
}
function cancelEdit(){APP.editMsgId=null;var eb=$('edit-bar');if(eb)eb.style.display='none';}
function copyMsg(){
  closeAllMenus();
  var msgs=APP.msgs[APP.openChatId]||[];
  var msg=msgs.find(function(m){return m.id===APP.selectedMsgId;});
  if(!msg||!msg.tx)return;
  if(navigator.clipboard)navigator.clipboard.writeText(msg.tx).then(function(){showToast('Copied! 📋');});
  else showToast('Copied! 📋');
}
function forwardMsg(){closeAllMenus();showToast('Forward — contact chunein 📤');}
function deleteMsg(){
  closeAllMenus();
  var msgs=APP.msgs[APP.openChatId]||[];
  var msg=msgs.find(function(m){return m.id===APP.selectedMsgId;});
  if(!msg)return;
  if(confirm('Delete karna chahte hain?')){msg.deleted=true;renderMessages();saveState();showToast('Message delete ho gaya 🗑️');}
}
function starMsg(){
  closeAllMenus();
  if(!APP.selectedMsgId)return;
  var msgs=APP.msgs[APP.openChatId]||[];
  var msg=msgs.find(function(m){return m.id===APP.selectedMsgId;});
  if(!msg)return;
  var chat=APP.chats.find(function(c){return c.id===APP.openChatId;})||{n:'Chat'};
  var already=APP.starred.find(function(s){return s.id===msg.id&&s.chatId===APP.openChatId;});
  if(already){APP.starred=APP.starred.filter(function(s){return !(s.id===msg.id&&s.chatId===APP.openChatId);});showToast('Star remove ho gaya');}
  else{APP.starred.push({id:msg.id,chatId:APP.openChatId,chatName:chat.n,tx:msg.tx||'[Media]',ti:msg.ti,t:msg.t});showToast('Message starred! ⭐');}
  saveState();renderStarredList();
}
function renderStarredList(){
  var el=$('starred-list');if(!el)return;
  if(!APP.starred.length){el.innerHTML='<div style="padding:32px 20px;text-align:center;"><div style="font-size:48px;margin-bottom:12px;">⭐</div><div style="color:var(--t1);font-size:16px;font-weight:700;margin-bottom:6px;">Koi starred message nahi</div><div style="color:var(--d2);font-size:13px;line-height:1.6;">Message pe long press karein → Star dabao</div></div>';return;}
  el.innerHTML=APP.starred.map(function(s){return '<div class="star-item"><div style="color:var(--d2);font-size:11px;font-weight:700;margin-bottom:4px;">'+s.chatName+' • '+s.ti+'</div><div style="color:var(--t1);font-size:14px;">'+s.tx+'</div></div>';}).join('');
}

