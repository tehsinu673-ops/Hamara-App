.sound-item{display:flex;align-items:center;gap:12px;padding:11px 14px;border-bottom:1px solid var(--bc);cursor:pointer;transition:background .12s;}
.sound-item:active{background:var(--bg3);}
.sound-item.playing{background:#10b98110;}
.sound-disc{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--g9),#0a1a12);border:2px solid var(--g5);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.sound-disc.spin{animation:spin 3s linear infinite;}

/* ── EFFECTS / FILTERS ── */
.fx-bar{display:flex;gap:10px;padding:12px 14px;overflow-x:auto;flex-shrink:0;}
.fx-bar::-webkit-scrollbar{height:0;}
.fx-item{display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer;flex-shrink:0;}
.fx-thumb{width:54px;height:54px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;border:2.5px solid transparent;transition:border-color .15s;}
.fx-thumb.active{border-color:var(--g5);}
.fx-lbl{color:var(--d1);font-size:10px;font-weight:600;}

/* ── DISCOVER PANEL ── */
.disc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;padding:2px;}
.disc-item{aspect-ratio:4/5;background:var(--bg3);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:40px;cursor:pointer;position:relative;overflow:hidden;transition:opacity .15s;}
.disc-item:active{opacity:.7;}
.disc-tag{position:absolute;bottom:6px;left:6px;background:#00000088;color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:10px;}
.trend-item{display:flex;align-items:center;gap:12px;padding:11px 14px;border-bottom:1px solid var(--bc);cursor:pointer;transition:background .12s;}
.trend-item:active{background:var(--bg3);}
.trend-rank{width:24px;color:var(--d2);font-size:13px;font-weight:800;text-align:center;}
.trend-tag{color:var(--t1);font-size:15px;font-weight:700;}
.trend-count{color:var(--d2);font-size:12px;margin-top:2px;}

