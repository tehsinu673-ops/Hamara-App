.gift-panel{position:fixed;bottom:0;left:50%;transform:translate(-50%,100%);width:100%;max-width:480px;background:var(--bg2);border-radius:22px 22px 0 0;border-top:1px solid var(--bc);z-index:320;padding:16px 20px 30px;transition:transform .32s cubic-bezier(.25,.46,.45,.94);}
