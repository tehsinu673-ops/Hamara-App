  var thumb=$('fx-'+fx);if(thumb)thumb.classList.add('active');
  $('fx-emoji').textContent=em;
  var overlays={smooth:'background:rgba(255,200,150,.15)',glow:'background:rgba(255,255,255,.2)',warm:'background:rgba(255,100,0,.12)',cool:'background:rgba(0,150,255,.12)',vintage:'background:rgba(100,60,20,.25)',none:''};
  $('fx-overlay').style.cssText=overlays[fx]||'';
  showToast(fx==='none'?'Normal mode':'FX: '+fx+' applied!');
}
