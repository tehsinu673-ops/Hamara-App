function sendPoll(){
  var q=($('poll-q')||{}).value||'';if(!q.trim()){showToast('Sawal likhein 📊');return;}
  var opts=Array.from(qsa('.poll-opt-inp')).map(function(i){return i.value.trim();}).filter(Boolean);
  if(opts.length<2){showToast('2+ options chahiye');return;}
  var pollHtml='<div class="poll-card"><div style="color:var(--t1);font-size:14px;font-weight:800;margin-bottom:4px;">📊 '+escHtml(q)+'</div>'+opts.map(function(o,i){return '<div class="poll-opt" onclick="votePoll(this,'+i+')"><div class="poll-fill" style="width:0%"></div><div class="poll-row"><span class="poll-lbl">'+escHtml(o)+'</span><span class="poll-pct">0%</span></div></div>';}).join('')+'<div style="color:var(--d2);font-size:11px;margin-top:6px;">0 votes</div></div>';
  if(APP.openChatId){
    if(!APP.msgs[APP.openChatId])APP.msgs[APP.openChatId]=[];
    APP.msgs[APP.openChatId].push({id:'poll'+Date.now(),t:'out',tx:pollHtml,ti:getTime(),type:'poll',read:false});
    renderMessages();
  }
  closeFeat('s-poll-create');showToast('Poll bhej diya! 📊');
}
function votePoll(el,idx){
  var opts=el.parentElement.querySelectorAll('.poll-opt');
  opts.forEach(function(o){o.classList.remove('voted');o.querySelector('.poll-fill').style.width='0%';o.querySelector('.poll-pct').textContent='0%';});
  el.classList.add('voted');
