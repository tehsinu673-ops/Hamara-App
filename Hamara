function openMsgMenu(e,id){
  e.preventDefault();e.stopPropagation();
  APP.selectedMsgId=id;
  var menu=$('msg-menu');var msgs=APP.msgs[APP.openChatId]||[];
  var msg=msgs.find(function(m){return m.id===id;});
  if(!msg)return;
  $('menu-edit-btn').style.display=msg.t==='out'&&msg.type==='text'?'flex':'none';
  $('menu-del-btn').style.display=msg.t==='out'?'flex':'none';
  var x=Math.min(e.clientX||e.touches&&e.touches[0].clientX||100,window.innerWidth-210);
  var y=Math.min(e.clientY||e.touches&&e.touches[0].clientY||200,window.innerHeight-300);
