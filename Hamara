/* ── CHAT LIST ── */
function setChatFilter(f,btn){
  APP.chatFilter=f;
  qsa('.filter-bar .fb').forEach(function(b){b.classList.remove('active');});
  if(btn)btn.classList.add('active');
  renderChatList();
}
function renderChatList(){
  var q = ($('chat-search')||{}).value||'';
  var el = $('chat-list');
  if(!el)return;
  var list = APP.chats.filter(function(c){
    if(q&&!c.n.toLowerCase().includes(q.toLowerCase()))return false;
    if(APP.chatFilter==='unread')return c.u>0;
    if(APP.chatFilter==='pinned')return APP.pinned.includes(c.id);
    return true;
  });
  // Sort pinned first
  list.sort(function(a,b){
    var ap=APP.pinned.includes(a.id)?-1:0;
    var bp=APP.pinned.includes(b.id)?-1:0;
    return ap-bp;
  });
  if(!list.length){el.innerHTML='<div style="padding:30px 20px;text-align:center;color:var(--d2);font-size:14px;">Koi chat nahi mila 🔍</div>';return;}
  el.innerHTML=list.map(function(c){
    var pin=APP.pinned.includes(c.id)?'<i class="fas fa-thumbtack" style="color:var(--d2);font-size:10px;"></i>':'';
    return '<div class="chat-row" onclick="openChat(\''+c.id+'\')" oncontextmenu="chatLongPress(event,\''+c.id+'\')"><div style="position:relative;"><div class="av '+c.av+'" style="width:48px;height:48px;font-size:16px;">'+c.in+'</div>'+(c.online?'<div class="online-dot"></div>':'')+'</div><div style="flex:1;min-width:0;"><div style="display:flex;align-items:center;gap:5px;"><span class="chat-row-name">'+c.n+'</span>'+(c.verified?'<i class="fas fa-circle-check" style="color:#38bdf8;font-size:11px;"></i>':'')+pin+'</div><div class="chat-row-sub">'+c.pre+'</div></div><div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;"><span class="chat-time">'+c.t+'</span>'+(c.u?'<span class="unread">'+c.u+'</span>':'')+'</div></div>';
  }).join('');
  // Pinned strip
  renderPinnedStrip();
  // Badge
  var total = APP.chats.reduce(function(s,c){return s+c.u;},0);
  var badge = $('badge-chats');
  if(badge){badge.style.display=total?'':'none';badge.textContent=total;}
}
function renderPinnedStrip(){
  var strip = $('pinned-strip');
  if(!strip)return;
  if(!APP.pinned.length){strip.style.display='none';return;}
  strip.style.display='flex';
  strip.innerHTML='<div style="color:var(--d2);font-size:10px;font-weight:700;flex-shrink:0;align-self:center;">📌</div>'+APP.pinned.map(function(id){
    var c=APP.chats.find(function(x){return x.id===id;});
    if(!c)return'';
    return '<div class="pin-chip" onclick="openChat(\''+id+'\')"><div class="pin-chip-av '+c.av+'">'+c.in+'</div><div class="pin-chip-name">'+c.n.split(' ')[0]+'</div></div>';
  }).join('');
}
function chatLongPress(e,id){
  e.preventDefault();
  pinChat(id);
}
function pinChat(id){
  if(APP.pinned.includes(id)){APP.pinned=APP.pinned.filter(function(x){return x!==id;});showToast('Chat unpin ho gaya');}
  else{APP.pinned.unshift(id);showToast('Chat pin ho gaya 📌');}
  saveState();renderChatList();
}

/* ── OPEN CHAT ── */
function openChat(id){
  APP.openChatId=id;
  var chat=APP.chats.find(function(c){return c.id===id;});
  if(!chat)return;
  // Update UI
  $('chat-av').className='av '+chat.av;$('chat-av').style.cssText='width:36px;height:36px;font-size:13px;';
  $('chat-av').textContent=chat.in;
  $('chat-name').innerHTML=chat.n+(chat.verified?' <i class="fas fa-circle-check" style="font-size:11px;color:#38bdf8;"></i>':'')+' <i class="fas fa-lock" style="font-size:10px;color:var(--g5);"></i>';
  $('chat-sub').textContent=chat.city+', '+chat.ctr+(chat.online?' • Online':'');
  var dot=$('chat-online-dot');dot.style.display=chat.online?'block':'none';
  // Show chat screen
  $('s-chat').style.display='flex';
  if(!APP.msgs[id])APP.msgs[id]=[];
  // Mark read
  APP.msgs[id].forEach(function(m){m.read=true;});
  chat.u=0;
  renderMessages();
  // Simulate typing
  if(chat.online){
    setTimeout(function(){
      $('typing-bar').style.display='flex';
      $('typing-text').textContent=chat.n.split(' ')[0]+' type kar raha hai...';
      setTimeout(function(){$('typing-bar').style.display='none';},2500);
    },1200);
  }
  renderChatList();
}
function closeChat(){$('s-chat').style.display='none';APP.openChatId=null;clearReply();cancelEdit();}

