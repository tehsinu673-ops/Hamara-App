  var chat=APP.chats.find(function(c){return c.id===APP.openChatId;})||{n:'Contact',av:'av1',in:'?'};
  $('call-av').className='av '+chat.av;$('call-av').style.cssText='width:110px;height:110px;font-size:42px;font-weight:800;border:4px solid var(--g5);margin-top:50px;box-shadow:0 0 60px #10b98155;animation:pulse 2s infinite;';$('call-av').textContent=chat.in;
