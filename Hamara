/* ── QR CODE ── */
function drawQR(){
  var canvas=$('qr-canvas');if(!canvas)return;
  var ctx=canvas.getContext('2d');if(!ctx)return;
  canvas.width=200;canvas.height=200;
  ctx.fillStyle='#fff';ctx.fillRect(0,0,200,200);
  var cs=8,pad=8,gs=21;
  var seed=(APP.user&&APP.user.username)||'hamara';
  function pr(i,j){var h=0;var s=seed+(i*31+j*17);for(var k=0;k<s.length;k++){h=(Math.imul(31,h)+s.charCodeAt(k))|0;}return((h>>>0)%100)<50;}
  [[0,0],[14,0],[0,14]].forEach(function(p){
    var r=p[0],c=p[1];
    ctx.fillStyle='#000';ctx.fillRect(pad+c*cs,pad+r*cs,7*cs,7*cs);
    ctx.fillStyle='#fff';ctx.fillRect(pad+c*cs+cs,pad+r*cs+cs,5*cs,5*cs);
    ctx.fillStyle='#000';ctx.fillRect(pad+c*cs+2*cs,pad+r*cs+2*cs,3*cs,3*cs);
  });
  for(var i=0;i<gs;i++){for(var j=0;j<gs;j++){var inFP=((i<8&&j<8)||(i<8&&j>12)||(i>12&&j<8));if(!inFP&&pr(i,j)){ctx.fillStyle='#000';ctx.fillRect(pad+j*cs,pad+i*cs,cs-1,cs-1);}}}
  var nm=$('qr-name'),us=$('qr-user');
  if(nm&&APP.user)nm.textContent=APP.user.name;
  if(us&&APP.user)us.textContent='@'+APP.user.username;
}

/* ── LOCK ── */
function lockPress(d){
  APP.lockPin+=d;
  for(var i=0;i<4;i++){var dot=$('ld'+i);if(dot)dot.classList.toggle('filled',i<APP.lockPin.length);}
  if(APP.lockPin.length>=4){
    if(APP.lockPin===APP.lockCorrect){unlockApp();}
    else{$('lock-err').textContent='Galat PIN!';APP.lockPin='';setTimeout(function(){for(var i=0;i<4;i++){var d=$('ld'+i);if(d)d.classList.remove('filled');}$('lock-err').textContent='';},700);}
  }
}
function lockDel(){APP.lockPin=APP.lockPin.slice(0,-1);for(var i=0;i<4;i++){var d=$('ld'+i);if(d)d.classList.toggle('filled',i<APP.lockPin.length);}}
function unlockApp(){$('lock-screen').classList.remove('open');APP.lockPin='';for(var i=0;i<4;i++){var d=$('ld'+i);if(d)d.classList.remove('filled');}showToast('Unlock ho gaya! 🔓');}

